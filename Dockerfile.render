FROM node:22-alpine AS frontend-build
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --cache /build/.npm-cache
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /backend

RUN apt-get update \
    && apt-get install -y --no-install-recommends apache2-utils ca-certificates nginx supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home appuser

COPY backend/requirements.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt
COPY backend/ ./
COPY --from=frontend-build /build/frontend/dist /usr/share/nginx/html
COPY deploy/nginx.render.conf.template /etc/nginx/conf.d/ramukaka.template
COPY deploy/supervisord.render.conf /etc/supervisor/conf.d/ramukaka.conf
COPY deploy/render-entrypoint.sh /usr/local/bin/render-entrypoint

RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf \
    && mkdir -p /backend/data /etc/nginx/snippets /run/nginx /var/log/supervisor \
    && chown -R appuser:appuser /backend \
    && chmod 0755 /usr/local/bin/render-entrypoint

EXPOSE 10000
ENTRYPOINT ["/usr/local/bin/render-entrypoint"]
