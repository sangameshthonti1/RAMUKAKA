# Safe examples only. No real credentials are required or used.
# Defaults work without a .env. To use this file, pass --env-file ../.env.example
# to Uvicorn from backend/, or use docker compose (which loads it explicitly).
APP_ENV=development
DATABASE_URL=sqlite:///./ramu_kaka.db
CONNECTOR_MODE=mock
AI_PROVIDER=mock
AI_API_KEY=
GNANI_API_KEY=
PINE_LABS_API_KEY=
DELHIVERY_API_KEY=
WHATSAPP_ACCESS_TOKEN=
RK_FRONTEND_ORIGIN=http://localhost:5173
RK_AUTO_MIGRATE=true
RK_AUTO_SEED=true
# Non-mock connectors/models currently fail closed. Adding keys does NOT enable them.
